# Databricks 실호출 시험(e2e)에 쓰는 값. 복사해서 .env.e2e로 저장한다 (.env.e2e는 git 제외).
AOPS_E2E_PROFILE=<databricks-cli-profile>
AOPS_E2E_SCHEMA=<catalog>.<schema>
AOPS_E2E_WAREHOUSE_ID=<serverless-sql-warehouse-id>
# 샘플 레지스트리 데이터(scripts/make_sample_registry.py)에 쓰는 값
AOPS_E2E_HOST=https://<workspace-host>
AOPS_E2E_WORKSPACE_ID=<workspace-id>
AOPS_E2E_DEVELOPER=<요청자·담당자 이메일>
AOPS_E2E_APPROVER=<승인자 이메일, 요청자와 달라야 함>
